# Copy to `.env.oracle` ON THE VM ONLY (never commit this file).
# Values marked REPLACE_ must be filled in on the server.
SECRET_KEY=REPLACE_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://ables:REPLACE_DB_PASSWORD@db:5432/ables
POSTGRES_USER=ables
POSTGRES_PASSWORD=REPLACE_DB_PASSWORD
MAIL_SERVER=REPLACE_SMTP_HOST
MAIL_USERNAME=REPLACE_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_SMTP_APP_PASSWORD
