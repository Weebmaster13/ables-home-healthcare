SECRET_KEY=dev-change-this-before-production
FLASK_ENV=development
SITE_BASE_URL=http://127.0.0.1:5000
DATABASE_URL=sqlite:///instance/ablehome.db
# Production: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# or cPanel MySQL/MariaDB: mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
UPLOAD_FOLDER=instance/uploads
MAX_CONTENT_LENGTH=5242880
SESSION_HOURS=8
WTF_CSRF_TIME_LIMIT=3600
FORCE_HTTPS=false
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
ADMIN_RECOVERY_CODES_REQUIRED=false
PASSWORD_BREACH_CHECK_ENABLED=true
ADMIN_EMAIL=admin@ableshomehealthcare.com
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=admin@ableshomehealthcare.com
ENABLE_SMS_REMINDERS=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VIRUS_SCAN_COMMAND=
# Fail closed: in production, uploads are rejected when no scanner is set.
# Set to true only to accept unscanned uploads (documented risk).
UPLOAD_SCAN_FAIL_OPEN=false
BUSINESS_DETAILS_CONFIRMED=false
LEGAL_SCOPE_CONFIRMED=false
LEGAL_PRIVACY_REVIEW_CONFIRMED=false
APPROVED_PHOTOS_READY=false
GOOGLE_ANALYTICS_ID=
GOOGLE_SITE_VERIFICATION=
