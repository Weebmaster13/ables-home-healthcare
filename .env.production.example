SECRET_KEY=replace-with-a-long-random-production-secret-generated-by-python-secrets
# Authenticates backup fingerprints (HMAC). Set a long random value, keep it
# stable, and store it in a password manager separate from the backups. Record
# its ID with `python backup_db.py --print-key-id` so you can confirm after a
# restore that you still hold the right key. Rotating it makes older backups
# unverifiable.
BACKUP_FINGERPRINT_KEY=replace-with-a-long-random-backup-fingerprint-key
# Off-site backup destination that survives losing this host (a second host, a
# NAS, or a storage account that accepts SFTP). Key-based auth only; a password
# in the URL is refused so a credential never reaches a command line or a log.
# OFFSITE_BACKUP_KEY: private key path. OFFSITE_SFTP_KNOWN_HOSTS: pinned host key.
# A directory on this host is NOT off-site and does not satisfy the readiness check.
OFFSITE_BACKUP_URL=sftp://REPLACE_USER@REPLACE_BACKUP_HOST/home/REPLACE_USER/ables-backups
OFFSITE_BACKUP_KEY=/home/REPLACE_USER/.ssh/id_ables_backup
OFFSITE_SFTP_KNOWN_HOSTS=/home/REPLACE_USER/.ssh/known_hosts_backup
OFFSITE_RETENTION=10
FLASK_ENV=production
SITE_BASE_URL=https://REPLACE_WITH_FINAL_DOMAIN
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
# cPanel MySQL/MariaDB alternative (install PyMySQL; bare mysql:// is normalized):
# DATABASE_URL=mysql+pymysql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:3306/REPLACE_DATABASE
UPLOAD_FOLDER=/var/data/uploads
MAX_CONTENT_LENGTH=5242880
SESSION_HOURS=8
WTF_CSRF_TIME_LIMIT=3600
FORCE_HTTPS=true
ACCOUNT_LOCKOUT_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
ADMIN_RECOVERY_CODES_REQUIRED=true
PASSWORD_BREACH_CHECK_ENABLED=true
ADMIN_EMAIL=admin@ableshomehealthcare.com
MAIL_SERVER=REPLACE_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_SMTP_PASSWORD_OR_APP_PASSWORD
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=admin@ableshomehealthcare.com
ENABLE_SMS_REMINDERS=false
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_FROM_NUMBER=+13013262225
VIRUS_SCAN_COMMAND=
# Fail closed: with no scanner above, production uploads are rejected.
# Set to true only to accept unscanned client/caregiver documents (documented risk).
UPLOAD_SCAN_FAIL_OPEN=false
# Set LOG_TO_FILE=false on ephemeral hosts or for read-only checks (stream logs stay on).
LOG_TO_FILE=true
BUSINESS_DETAILS_CONFIRMED=false
LEGAL_SCOPE_CONFIRMED=false
LEGAL_PRIVACY_REVIEW_CONFIRMED=false
APPROVED_PHOTOS_READY=false
GOOGLE_ANALYTICS_ID=G-REPLACE_WITH_ANALYTICS_ID
GOOGLE_SITE_VERIFICATION=replace-with-google-search-console-verification-token
